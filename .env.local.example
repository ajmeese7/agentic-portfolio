# Pick any OpenAI-compatible endpoint.
#
# OpenAI:
#   LLM_BASE_URL=https://api.openai.com/v1
#   LLM_API_KEY=sk-...
#   LLM_MODEL=gpt-4o-mini
#
# Ollama (local):
#   LLM_BASE_URL=http://localhost:11434/v1
#   LLM_API_KEY=ollama
#   LLM_MODEL=llama3.1:8b
#
# LM Studio (local):
#   LLM_BASE_URL=http://localhost:1234/v1
#   LLM_API_KEY=lm-studio
#   LLM_MODEL=your-loaded-model-id
#
# OpenRouter:
#   LLM_BASE_URL=https://openrouter.ai/api/v1
#   LLM_API_KEY=sk-or-...
#   LLM_MODEL=anthropic/claude-3.5-sonnet
#
# Groq:
#   LLM_BASE_URL=https://api.groq.com/openai/v1
#   LLM_API_KEY=gsk_...
#   LLM_MODEL=llama-3.3-70b-versatile

LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# Reasoning models (Qwen3, DeepSeek-R1, etc.) emit a chain-of-thought we
# never display. Defaults to off ("true" = thinking disabled) for snappier
# chat; set to "false" if you want reasoning kept on. Non-reasoning models
# silently ignore the request param either way.
# LLM_DISABLE_THINKING=true

# Optional: avatar text-to-speech (OpenAI TTS).
# When unset, the avatar falls back to the browser's built-in
# speechSynthesis API so it still talks -- just in the OS voice.
# TTS_API_KEY can reuse LLM_API_KEY if you're using OpenAI for both.
# Voices: alloy | echo | fable | onyx | nova | shimmer
TTS_API_KEY=
TTS_VOICE=echo

# Comma-separated list of extra origins allowed to hit `pnpm dev` from
# another machine on your LAN (your phone, a second laptop, etc.).
# Loopback addresses are always allowed; only add hosts/IPs Next would
# otherwise reject as cross-origin. Leave blank if you only ever load the
# dev server from this machine.
# ALLOWED_DEV_ORIGINS=192.168.1.204,my-laptop.local
